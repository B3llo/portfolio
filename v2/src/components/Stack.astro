---
import { TECH_GROUPS } from "../data/portfolio";
---

<section id="stack" aria-label="Technologies" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <p class="sec-label rv"><span class="n">02</span>ls ~/stack/</p>
  <dl class="rv mt-4 border-t rule">
    {
      TECH_GROUPS.map((g) => (
        <div class="grid grid-cols-[110px_1fr] gap-3 border-b py-2.5 rule sm:grid-cols-[170px_1fr]">
          <dt class="text-[13px]" style="color: var(--acc);">./{g.label}</dt>
          <dd class="font-code text-[13px]">{g.items.join("  ")}</dd>
        </div>
      ))
    }
  </dl>
</section>
