---
import { CERTIFICATIONS } from "../data/portfolio";
---

<section id="certs" aria-label="Certifications" class="mx-auto max-w-4xl px-4 pb-10 sm:px-6">
  <div class="rv border-t rule pt-4">
    <h2 class="text-[13px] uppercase tracking-widest" style="color: var(--mut);">
      ## certifications
    </h2>
    <ul class="mt-3 space-y-2">
      {
        CERTIFICATIONS.map((c) => (
          <li class="flex items-baseline justify-between gap-4 text-[13.5px]">
            <span>
              <span class="font-bold">{c.name}</span>
              <span class="font-code text-xs" style="color: var(--mut);"> @{c.issuer}</span>
            </span>
            <span class="shrink-0 font-code text-xs" style="color: var(--acc);">[{c.short}]</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
