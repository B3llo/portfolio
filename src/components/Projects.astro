---
import type { getProjects } from "../data/github";
import { getProjectNote } from "../data/project-notes";

interface Props {
  feed: Awaited<ReturnType<typeof getProjects>>;
}

const { projects, source } = Astro.props.feed;
---

<section id="work" class="shell section projects" aria-labelledby="work-title">
  <div class="projects-intro">
    <h2 id="work-title" data-signal-heading><span class="signal-label">Public projects</span></h2>
    <p>{source === "github" ? "My newest public repositories on GitHub." : "A selection of my public repositories on GitHub."}</p>
    <a class="text-link" href="https://github.com/B3llo?tab=repositories">All repositories <span aria-hidden="true">↗</span></a>
  </div>
  <ul class="projects-list" role="list">
    {projects.map((project) => {
      const note = getProjectNote(project.name);
      const description = note?.description ?? project.description;
      const topics = note?.topics ?? project.topics;
      return (
        <li class="project" data-motion-row>
          <div class="project-body">
          <h3><a href={project.url}>{note?.title ?? project.name}</a></h3>
          {description && <p class="project-description">{description}</p>}
          {(topics.length > 0 || ("stars" in project && project.stars > 0)) && (
            <div class="project-meta">
              {topics.length > 0 && (
                <ul class="topics" role="list" aria-label={`Topics for ${project.name}`}>
                  {topics.map((topic) => <li>{topic}</li>)}
                </ul>
              )}
              {"stars" in project && project.stars > 0 && (
                <span class="stars"><span aria-hidden="true">☆</span> {project.stars.toLocaleString("en")}
                  <span class="sr-only"> GitHub {project.stars === 1 ? "star" : "stars"}</span>
                </span>
              )}
            </div>
          )}
          </div>
        </li>
      );
    })}
  </ul>
</section>
