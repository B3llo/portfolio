---
import { PROFILE } from "../data/portfolio";
import Chassis from "./Chassis.astro";
const parts = PROFILE.name.split(" ");
const surname = parts.pop();
---

<section class="shell hero" aria-labelledby="hero-title" data-machining>
  <div class="hero-identity">
    <p class="hero-byline">{PROFILE.role} <span>/</span> {PROFILE.location}</p>
    <h1 id="hero-title" data-signal-heading>
      <span class="sr-only">{PROFILE.name}</span>
      <span class="hero-first" aria-hidden="true">{parts.join(" ")}</span>
      <span class="cut-name" aria-hidden="true">
        <span class="name-size">{surname}</span>
        {[0,1,2].map(i => <span class={`name-slice slice-${i}`}>{surname}</span>)}
      </span>
    </h1>
  </div>
  <Chassis />
  <div class="hero-copy">
    <p class="hero-intro">At {PROFILE.employer}, I work on provisioning, deployments, and observability. Outside work, I build tools I can run on my own server.</p>
    <div class="hero-links">
      <a class="text-link" href="#work">See what I build <span aria-hidden="true">↓</span></a>
      <a class="text-link" href="#career">Experience</a>
    </div>
  </div>
</section>
