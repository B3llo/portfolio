---
import { CERTIFICATIONS } from "../data/portfolio";
---

<section id="certs" class="certifications" aria-labelledby="certs-title">
  <h3 id="certs-title">Certifications</h3>
  <ul role="list">
    {CERTIFICATIONS.map((cert) => (
      <li>
        <div class="cert-short" aria-hidden="true">{cert.short}</div>
        <div><p class="cert-name">{cert.name}</p><p class="cert-issuer">{cert.issuer}</p></div>
      </li>
    ))}
  </ul>
</section>
