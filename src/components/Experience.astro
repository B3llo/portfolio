---
import { EXPERIENCE } from "../data/portfolio";
---

<section id="career" aria-label="Experience" class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <p class="sec-label rv"><span class="n">03</span>git log --career --oneline</p>
  <ol class="rv mt-4 border-t rule">
    {
      EXPERIENCE.map((e) => (
        <li class="border-b py-4 rule">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-[15px] font-bold">
              <span style="color: var(--acc);">*</span> {e.company}
            </h3>
            <span class="font-code text-xs" style="color: var(--mut);">[{e.period}]</span>
          </div>
          <p class="mt-1 text-[13px]" style="color: var(--acc);">
            {e.role}{e.current ? " [current]" : ""}
          </p>
          <p class="mt-2 max-w-prose text-[13.5px] leading-relaxed">{e.summary}</p>
        </li>
      ))
    }
  </ol>
</section>
