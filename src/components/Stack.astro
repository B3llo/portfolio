---
import { TECH_GROUPS } from "../data/portfolio";
---

<section id="stack" class="stack" aria-labelledby="stack-title">
  <h2 id="stack-title">Tech stack</h2>
  <dl>
    {TECH_GROUPS.map((group) => (
      <div>
        <dt>{group.label}</dt>
        <dd>{group.items.join(", ")}</dd>
      </div>
    ))}
  </dl>
</section>
