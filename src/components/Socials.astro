---
import { SOCIALS } from "../data/portfolio";
---

<ul class="flex flex-wrap gap-x-4 gap-y-2 text-[13px]">
  {
    SOCIALS.map((s) => (
      <li>
        <a
          href={s.href}
          target={s.href.startsWith("mailto:") ? undefined : "_blank"}
          rel={s.href.startsWith("mailto:") ? undefined : "noopener"}
          class="u-link"
        >
          {s.label} ↗
        </a>
      </li>
    ))
  }
</ul>
