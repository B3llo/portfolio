---
import { PROFILE } from "../data/portfolio";

const links = [
  { href: "#work", label: "Projects" },
  { href: "#career", label: "Experience" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="#top" aria-label={`${PROFILE.handle}.sh, back to top`}>
      <span class="wordmark-mark" aria-hidden="true">&gt;_</span>
      <span>{PROFILE.handle}<span class="wordmark-dot">.sh</span></span>
    </a>
    <nav aria-label="Primary">
      <ul>{links.map(({ href, label }) => <li><a href={href}><span aria-hidden="true">/</span>{label}</a></li>)}</ul>
    </nav>
    <button type="button" class="theme-toggle" id="theme-toggle" hidden>
      <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" />
      </svg>
      <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.6 15A9 9 0 0 1 9 3.4 9 9 0 1 0 20.6 15Z" />
      </svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  if (toggle) {
    const syncTheme = () => {
      const light = root.dataset.theme === "light";
      const label = `Switch to ${light ? "dark" : "light"} theme`;
      toggle.setAttribute("aria-label", label);
      toggle.title = label;
      if (meta) meta.content = light ? "#f3f2e7" : "#101210";
    };
    syncTheme();
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      const theme = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = theme;
      syncTheme();
      try { localStorage.setItem("ops-theme", theme); } catch {}
    });
  }
</script>
