---
import { PROFILE } from "../data/portfolio";
import Socials from "./Socials.astro";
---

<section id="contact" class="shell section contact" aria-labelledby="contact-title">
  <h2 id="contact-title" data-signal-heading><span class="signal-label">Contact</span></h2>
  <div class="contact-details">
    <a href={`mailto:${PROFILE.email}`} class="text-link contact-email">{PROFILE.email}</a>
    <Socials />
  </div>
</section>
